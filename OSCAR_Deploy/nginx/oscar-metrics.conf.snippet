# OSCAR metrics + Grafana — nginx snippet to add inside the existing
# `server { listen 443 ssl; server_name oscar.uic.org; ... }` block.
#
# Three pieces:
#   1. Block external access to OSCAR's /metrics endpoint (returns 404).
#   2. Internal SSO check that proxies to OSCAR's /v1/auth/sso-check.
#      Used by `auth_request` directives below to gate Grafana access.
#   3. Reverse-proxy /grafana/ to the local Grafana container, gated by
#      OSCAR SSO (admin role required). Grafana's auth.proxy module
#      reads the X-WEBAUTH-USER header set from the SSO check.
#
# Replaces the basic-auth setup from v1.5.0. After this is in place,
# any user signed in to OSCAR as administrator can click through to
# Grafana with no second login. Non-admins get 401.
#
# To install:
#   1. (Old basic-auth file is no longer used; you can leave or delete
#      /etc/nginx/.htpasswd-grafana — it's no longer referenced.)
#   2. Copy the three `location` blocks below into your existing
#      oscar.uic.org server block, anywhere alongside the existing
#      `location /` (which proxies the OSCAR app).
#   3. Reload nginx:
#        sudo nginx -t && sudo systemctl reload nginx
# ─────────────────────────────────────────────────────────────────────────────

# Block external scrapes of /metrics — only the in-cluster Prometheus
# (which talks directly to oscar:3001 over the docker bridge) should
# read them. Anyone hitting https://oscar.uic.org/metrics gets a 404
# that doesn't even reveal the endpoint exists.
location = /metrics {
    return 404;
}

# Internal SSO check — called by `auth_request` below, NOT directly
# reachable from clients. nginx forwards the user's oscar_session cookie
# (and any Authorization: Bearer header) to OSCAR /v1/auth/sso-check,
# which validates the JWT and returns 200 + X-User-Email + X-User-Role
# if the user is an administrator, 401 otherwise.
#
# `internal` ensures this location can only be invoked via auth_request
# from within the nginx config — never from an outside HTTP request.
location = /auth/sso-check {
    internal;
    proxy_pass              http://127.0.0.1:3001/v1/auth/sso-check;
    proxy_pass_request_body off;
    proxy_set_header        Content-Length "";
    proxy_set_header        Host            $host;
    proxy_set_header        X-Original-URI  $request_uri;
    # Forward the user's auth context — both the cookie (browser
    # navigation) and any Authorization header (curl / scripted access).
    proxy_set_header        Cookie          $http_cookie;
    proxy_set_header        Authorization   $http_authorization;
}

# Grafana — reverse-proxied under /grafana/, gated by OSCAR SSO.
# Grafana's GF_SERVER_SERVE_FROM_SUB_PATH is set to true in the compose
# overlay so internal Grafana links work correctly under this prefix.
#
# IMPORTANT: `proxy_pass http://127.0.0.1:3000;` MUST NOT have a trailing
# slash. With a trailing slash nginx strips the /grafana/ prefix before
# forwarding, but Grafana (with serve_from_sub_path=true) expects to see
# /grafana/ in the URL — leading to an infinite redirect loop. PR #45
# bake-in — was diagnosed live in production after v1.5.0 shipped.
location /grafana/ {
    # Call the SSO check — on 200 the request continues, on 401 the user
    # is bounced to OSCAR's login page (where they sign in normally and
    # then come back to /grafana/ via the menu link).
    auth_request        /auth/sso-check;
    error_page 401 = @sso_login;

    # Capture the X-User-Email + X-User-Role from the auth_request
    # response and pass them upstream as X-WEBAUTH-USER + X-User-Role
    # so Grafana's auth.proxy can use them.
    auth_request_set    $sso_user  $upstream_http_x_user_email;
    auth_request_set    $sso_role  $upstream_http_x_user_role;
    proxy_set_header    X-WEBAUTH-USER  $sso_user;
    proxy_set_header    X-User-Email    $sso_user;
    proxy_set_header    X-User-Role     $sso_role;

    proxy_pass          http://127.0.0.1:3000;
    proxy_set_header    Host              $host;
    proxy_set_header    X-Real-IP         $remote_addr;
    proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header    X-Forwarded-Proto $scheme;
    # Grafana live (websockets) — required for the live tail / alert pages.
    proxy_http_version  1.1;
    proxy_set_header    Upgrade           $http_upgrade;
    proxy_set_header    Connection        "upgrade";
}

# Where the SSO check sends users who are not signed in (or not admins):
# back to OSCAR's login page with a return-to query string so they land
# on the requested resource after logging in.
location @sso_login {
    return 302 /index.html?next=$request_uri;
}
