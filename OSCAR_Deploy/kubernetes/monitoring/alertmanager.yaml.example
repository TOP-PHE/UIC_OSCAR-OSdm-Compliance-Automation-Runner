# Alertmanager's configuration on a cluster: e-mail to OSCAR's administrators,
# as the VPS's (OSCAR_Deploy/alertmanager/alertmanager.yml.example), plus two
# routes for the chart's own alerts. Copy it outside the repository, fill in
# the mail server and the address, then make it a Secret (it holds the mail
# server's password):
#   kubectl -n monitoring create secret generic oscar-alertmanager --from-file=alertmanager.yaml=<your file>
# To change it later: the same command with --dry-run=client -o yaml | kubectl apply -f -
# Alertmanager reads it again within a minute.

global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp-relay.example.org:587'
  smtp_from: 'OSCAR Alerts <noreply@oscar.example.org>'
  smtp_auth_username: 'YOUR_SMTP_USERNAME_HERE'
  smtp_auth_password: 'YOUR_SMTP_PASSWORD_HERE'
  smtp_require_tls: true

route:
  receiver: oscar-admins
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # The chart's Watchdog always fires (it shows the alert chain works) and
    # InfoInhibitor only silences "info" alerts: neither is mailed.
    - matchers:
        - alertname =~ "Watchdog|InfoInhibitor"
      receiver: 'null'
    # "info" alerts of the chart (a quota nearly full, CPU throttling) are seen
    # in Grafana, not mailed.
    - matchers:
        - severity = "info"
      receiver: 'null'
    - matchers:
        - severity = "critical"
      receiver: oscar-admins
      repeat_interval: 1h

receivers:
  - name: 'null'
  - name: oscar-admins
    email_configs:
      - to: 'oscar-admins@example.org'
        send_resolved: true
        headers:
          Subject: '[OSCAR {{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'

inhibit_rules:
  - source_matchers:
      - alertname = "OscarServerDown"
    target_matchers:
      - severity = "warning"
    equal: ['service']
