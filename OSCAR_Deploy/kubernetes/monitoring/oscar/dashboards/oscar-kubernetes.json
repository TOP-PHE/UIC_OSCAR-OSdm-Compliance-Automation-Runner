      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(max_over_time(kube_pod_container_status_terminated_reason{namespace=\"oscar-runs\", container=\"run\", reason=\"OOMKilled\"}[$__range]) == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Runs stopped for memory",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Run pods that ended in the time shown, from OSCAR's own count (any outcome).",
