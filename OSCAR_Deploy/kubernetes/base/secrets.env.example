#
# OSCAR's secrets, as the Secret oscar-secrets. Copy this file OUTSIDE the
# repository, fill it in, create the Secret, then delete the copy:
#
#   kubectl create secret generic oscar-secrets --from-env-file=secrets.env
#   (on OpenShift: oc create secret generic … in the same way)
#
# Or let your secret manager (External Secrets, Vault, Sealed Secrets) write a
# Secret of that name with these keys.

# AES-256-GCM key of everything stored encrypted: credentials, data files,
# reports. 64 hex characters: openssl rand -hex 32
# KEEP A COPY APART FROM THE BACKUPS: the data volume cannot be read without it.
ENCRYPTION_KEY=

# Signing key of the sessions. openssl rand -hex 64
JWT_SECRET=

# One-time token to create the first administrator
# (POST /v1/auth/bootstrap/platform-user). openssl rand -base64 48
PLATFORM_BOOTSTRAP_TOKEN=

# Bearer token /metrics asks for. Without it, /metrics is open to anyone who
# reaches the Ingress or Route. openssl rand -hex 32
METRICS_TOKEN=

# Mail server password, when SMTP_USER is set in the settings.
SMTP_PASS=
