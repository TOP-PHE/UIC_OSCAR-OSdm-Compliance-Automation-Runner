# OSCAR's settings that are not secret, as the ConfigMap oscar-settings.
# The same variables as OSCAR_Deploy/.env.example; the secrets are in
# secrets.env.example. Change them in an overlay (configMapGenerator with
# behavior: merge) rather than here.

# ── Fixed by the image: do not change ───────────────────────────────────────
NODE_ENV=production
PORT=3001
BRU_CMD=/usr/local/bin/bru
COLLECTION_PATH=/collection
COMPATIBILITY_FILE=/app/compatibility.json
JSON_SCHEMA_URL=http://127.0.0.1:3001/json_validator/datafile.schema.json
# A uid OpenShift chooses has no home directory; /tmp is an emptyDir.
HOME=/tmp

# ── Your address ────────────────────────────────────────────────────────────
# APP_URL (where the links of OSCAR's e-mails lead) and ALLOWED_REDIRECT_HOSTS
# (the host OSCAR redirects http to https on) are set by the overlay, next to
# the Ingress or Route that names the same host.

# ── Proxies ─────────────────────────────────────────────────────────────────
# Proxies in front of OSCAR that each add an X-Forwarded-For entry: 1 for the
# OpenShift router or ingress-nginx alone, 2 with a load balancer that adds
# its own in front of them. A wrong count shares one login rate limit among
# all users, or lets a user choose theirs. 0 to 5.
TRUST_PROXY_HOPS=1

# ── Runs ────────────────────────────────────────────────────────────────────
# About 4 per CPU of the pod's limit (deployment.yaml): each run is a Bruno
# process of about 0.2 CPU and 250 MB.
MAX_CONCURRENT_RUNS=6
RUN_TIMEOUT_MS=600000
PARALLEL_STAGGER_MS=2000

# ── The rest ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
TZ=Europe/Paris
# For password-reset and approval e-mails; SMTP_PASS goes in the Secret.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=oscar@example.org
# SMTP_FROM=OSCAR <oscar@example.org>

# Providers reached at a private address (through a VPN, on the cluster's
# network): OSCAR refuses them unless ALLOW_PRIVATE_TARGETS=1, which turns
# off its check on outbound addresses entirely. If you set it, restrict the
# pod's outbound traffic with a NetworkPolicy or an EgressFirewall to the
# providers' addresses and your mail server. See the guide.
# ALLOW_PRIVATE_TARGETS=1
