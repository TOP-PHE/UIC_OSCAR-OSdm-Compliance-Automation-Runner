# OSCAR Server — Configuration template
#
# Copy this file to `.env` in the same folder and fill in the values.
# `.env` is gitignored at the repo root and must NEVER be committed.

# ── Required secrets ───────────────────────────────────────────────────────

# AES-256-GCM key used to encrypt user credentials at rest.
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# One-time bootstrap token used to create the first platform admin via
# POST /v1/auth/bootstrap/platform-user.
# Generate with: openssl rand -base64 48
PLATFORM_BOOTSTRAP_TOKEN=

# JWT signing secret. If left blank, the server generates a random one
# at startup, which invalidates all sessions on every restart. For a
# production deployment, set this to a stable random string.
# Generate with: openssl rand -hex 64
JWT_SECRET=

# ── Networking ─────────────────────────────────────────────────────────────

PORT=3001

# Comma-separated list of hostnames the HTTPS-redirect handler will trust as
# redirect targets (defense-in-depth against Host:-header forgery → open
# redirect, Sonar S5146). Set this in production to your canonical hostname(s).
# Example: ALLOWED_REDIRECT_HOSTS=oscar.uic.org
ALLOWED_REDIRECT_HOSTS=

# ── Runtime tuning ─────────────────────────────────────────────────────────

# Hard timeout per Bruno run (ms). 600000 = 10 min.
RUN_TIMEOUT_MS=600000

# Maximum number of Bruno runs that can execute concurrently.
MAX_CONCURRENT_RUNS=3

# Delay between staggered run launches in a parallel batch (ms).
PARALLEL_STAGGER_MS=2000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Wall-clock timezone used by every container in the stack (oscar, loki,
# promtail, grafana, prometheus, alertmanager, autoheal, watchtower).
# Affects log line timestamps, audit log entries, "Sent at" lines in
# emails, run start/finish times shown in the dashboard. Storage stays
# UTC ISO-8601 in the JSON layer — only the display side changes.
# Default Europe/Paris (canonical UIC OSCAR deployment).
# Override with any IANA zone, e.g. America/New_York, Asia/Tokyo.
OSCAR_TZ=Europe/Paris

# ── Datafile schema validation ────────────────────────────────────────────

# URL of the JSON schema OSCAR uses to validate uploaded datafiles.
#
# v1.11.112+ default: OSCAR_Server serves the schema bundled with the
# Bruno collection at this loopback URL. Works offline and always matches
# the running collection — no external dependency.
#
# Earlier installs may have an obsolete value pointing at
#   https://raw.githubusercontent.com/UnionInternationalCheminsdeFer/OSDM-testing/refs/heads/exch_dev/json_validator/datafile.schema.json
# That repo is deprecated and its schema is out of sync with the modern
# OSCAR datafile shape — it produces false-positive validation failures
# (typically "Required property 'offerSearchCriteriaList' is missing").
# Update older .env files to the loopback URL below.
JSON_SCHEMA_URL=http://127.0.0.1:3001/json_validator/datafile.schema.json

# ── SMTP (optional, for password-reset emails) ─────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
