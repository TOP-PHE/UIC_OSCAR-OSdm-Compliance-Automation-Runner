# OSCAR Server — Configuration template
#
# Copy this file to `.env` in the same folder and fill in the values.
# `.env` is gitignored at the repo root and must NEVER be committed.

# ── Required secrets ───────────────────────────────────────────────────────

# AES-256-GCM key used to encrypt user credentials at rest.
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# One-time bootstrap token used to create the first platform admin via
# POST /v1/auth/bootstrap/platform-user.
# Generate with: openssl rand -base64 48
PLATFORM_BOOTSTRAP_TOKEN=

# JWT signing secret. If left blank, the server generates a random one
# at startup, which invalidates all sessions on every restart. For a
# production deployment, set this to a stable random string.
# Generate with: openssl rand -hex 64
JWT_SECRET=

# ── Networking ─────────────────────────────────────────────────────────────

PORT=3001

# Comma-separated list of hostnames the HTTPS-redirect handler will trust as
# redirect targets (defense-in-depth against Host:-header forgery → open
# redirect, Sonar S5146). Set this in production to your canonical hostname(s).
# Example: ALLOWED_REDIRECT_HOSTS=oscar.uic.org
ALLOWED_REDIRECT_HOSTS=

# The address users reach OSCAR at: links in registration and password reset
# e-mails, and the reset link an administrator makes, are built from it.
# Example: APP_URL=https://oscar.uic.org
APP_URL=

# Comma-separated list of browser origins allowed to make cross-origin API calls
# (CORS). OSCAR is served same-origin behind nginx, so a normal deployment needs
# nothing here. When UNSET, CORS fails closed: no cross-origin is permitted and
# the same-origin app is unaffected (tracker S7-cors). Set this ONLY if you serve
# the UI from a different origin than the API.
# Example: ALLOWED_ORIGINS=https://oscar.uic.org,https://admin.oscar.uic.org
ALLOWED_ORIGINS=

# Proxies in front of OSCAR that each add an X-Forwarded-For entry (#1059).
# 1 (the default) for nginx on this host. 2 only if a load balancer that adds
# its own entry sits in front of nginx. 0 to 5; anything else stops the start.
# TRUST_PROXY_HOPS=1

# Bearer token /metrics asks for (#1059). Leave it unset here: nginx already
# answers 404 for /metrics from outside, and the bundled Prometheus scrapes
# without a token. Needed where no nginx guards the path (Kubernetes,
# OpenShift: OSCAR_Deploy/kubernetes/).
# METRICS_TOKEN=

# When a database COMMIT waits for the disk (#1224). NORMAL, the default: only
# when the journal is copied into the database file. The database stays safe
# from corruption; a power loss or a crash of the machine can roll back the
# last transactions (a crash of OSCAR alone cannot). FULL: every COMMIT waits,
# as before 1.11.508, about 7 ms each and up to a quarter of the server's
# thread during a batch. NORMAL or FULL; anything else stops the start.
# OSCAR_DB_SYNCHRONOUS=NORMAL

# Where the database's checkpoints run (#1230). thread, the default: a thread
# of their own copies the journal into the database file every second, and a
# COMMIT never does; if that thread stops, the COMMITs do it again. inline:
# the COMMIT that takes the journal past 1,000 pages does it, on the server's
# thread, as before 1.11.510 (0.1 to 0.26 s each on the k3s test machine).
# thread or inline; anything else stops the start.
# OSCAR_DB_CHECKPOINTS=thread

# From how many milliseconds a database statement is logged as slow (#1234).
# Each one writes a warning line "slow database statement" with its time, its
# SQL (never its values) and the place in OSCAR's code that ran it; OSCAR ·
# Logs lists them. A whole number from 1 to 60000, 50 by default; anything
# else stops the start.
# OSCAR_DB_SLOW_MS=50

# ── Runtime tuning ─────────────────────────────────────────────────────────

# Hard timeout per Bruno run (ms). 600000 = 10 min.
RUN_TIMEOUT_MS=600000

# Maximum number of Bruno runs that can execute concurrently.
MAX_CONCURRENT_RUNS=3

# Delay between staggered run launches in a parallel batch (ms).
PARALLEL_STAGGER_MS=2000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Wall-clock timezone used by every container in the stack (oscar, loki,
# promtail, grafana, prometheus, alertmanager, autoheal, watchtower).
# Affects log line timestamps, audit log entries, "Sent at" lines in
# emails, run start/finish times shown in the dashboard. Storage stays
# UTC ISO-8601 in the JSON layer — only the display side changes.
# Default Europe/Paris (canonical UIC OSCAR deployment).
# Override with any IANA zone, e.g. America/New_York, Asia/Tokyo.
OSCAR_TZ=Europe/Paris

# ── Datafile schema validation ────────────────────────────────────────────

# URL of the JSON schema OSCAR uses to validate uploaded datafiles.
#
# v1.11.112+ default: OSCAR_Server serves the schema bundled with the
# Bruno collection at this loopback URL. Works offline and always matches
# the running collection — no external dependency.
#
# Earlier installs may have an obsolete value pointing at
#   https://raw.githubusercontent.com/UnionInternationalCheminsdeFer/OSDM-testing/refs/heads/exch_dev/json_validator/datafile.schema.json
# That repo is deprecated and its schema is out of sync with the modern
# OSCAR datafile shape — it produces false-positive validation failures
# (typically "Required property 'offerSearchCriteriaList' is missing").
# Update older .env files to the loopback URL below.
JSON_SCHEMA_URL=http://127.0.0.1:3001/json_validator/datafile.schema.json

# ── SMTP (optional, for password-reset emails) ─────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Outbound target policy (tracker S5, v1.11.211) ─────────────────────────
# The company api_base (where runs send OSDM requests) and a tester's token_url
# (where OAuth tokens are fetched) must be public https addresses: OSCAR refuses
# loopback, private, link-local and Docker service names, at save and at use.
# Set this to 1 ONLY for a self-hosted / development box whose providers sit on
# localhost or a private network. A public deployment must leave it unset.
ALLOW_PRIVATE_TARGETS=
