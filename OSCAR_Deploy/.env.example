# OSCAR Server — Configuration template
#
# Copy this file to `.env` in the same folder and fill in the values.
# `.env` is gitignored at the repo root and must NEVER be committed.

# ── Required secrets ───────────────────────────────────────────────────────

# Each secret of this file may be given as a file instead (#1430): leave its
# line empty and set NAME_FILE, or use docker-compose.secrets.yml (see its
# header and OSCAR - Server Admin Guide, 13.7). Never both.
# AES-256-GCM key used to encrypt user credentials at rest.
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Bootstrap token used to create the first platform admin via
# POST /v1/auth/bootstrap/platform-user. The route creates that one only:
# once an administrator exists it answers 409. Then empty this line and
# create the container again (docker compose up -d oscar; a "restart" keeps
# the old value): the server reminds you at each start until it is removed.
# Generate with: openssl rand -base64 48
PLATFORM_BOOTSTRAP_TOKEN=

# Not read by the server: it makes its session (JWT) secret at its first
# start and keeps it in the database, so sessions survive restarts. To end
# every session, see "Security Operations Policy" 3.3
# (POST /v1/admin/rotate-jwt-secret). The line is kept so that an existing
# .env stays valid.
JWT_SECRET=

# ── Networking ─────────────────────────────────────────────────────────────

PORT=3001

# Comma-separated list of hostnames the HTTPS-redirect handler will trust as
# redirect targets (defense-in-depth against Host:-header forgery → open
# redirect, Sonar S5146). Set this in production to your canonical hostname(s).
# Example: ALLOWED_REDIRECT_HOSTS=oscar.uic.org
ALLOWED_REDIRECT_HOSTS=

# The address users reach OSCAR at: links in registration and password reset
# e-mails, and the reset link an administrator makes, are built from it.
# Example: APP_URL=https://oscar.uic.org
APP_URL=

# Comma-separated list of browser origins allowed to make cross-origin API calls
# (CORS). OSCAR is served same-origin behind nginx, so a normal deployment needs
# nothing here. When UNSET, CORS fails closed: no cross-origin is permitted and
# the same-origin app is unaffected (tracker S7-cors). Set this ONLY if you serve
# the UI from a different origin than the API.
# Example: ALLOWED_ORIGINS=https://oscar.uic.org,https://admin.oscar.uic.org
ALLOWED_ORIGINS=

# Proxies in front of OSCAR that each add an X-Forwarded-For entry (#1059).
# 1 (the default) for nginx on this host. 2 only if a load balancer that adds
# its own entry sits in front of nginx. 0 to 5; anything else stops the start.
# TRUST_PROXY_HOPS=1

# Bearer token /metrics asks for (#1059). Leave it unset here: nginx already
# answers 404 for /metrics from outside, and the bundled Prometheus scrapes
# without a token. Needed where no nginx guards the path (Kubernetes,
# OpenShift: OSCAR_Deploy/kubernetes/).
# METRICS_TOKEN=

# When a database COMMIT waits for the disk (#1224). NORMAL, the default: only
# when the journal is copied into the database file. The database stays safe
# from corruption; a power loss or a crash of the machine can roll back the
# last transactions (a crash of OSCAR alone cannot). FULL: every COMMIT waits,
# as before 1.11.508, about 7 ms each and up to a quarter of the server's
# thread during a batch. NORMAL or FULL; anything else stops the start.
# OSCAR_DB_SYNCHRONOUS=NORMAL

# Where the database's checkpoints run (#1230). thread, the default: a thread
# of their own copies the journal into the database file, and a COMMIT never
# does; if that thread stops, the COMMITs do it again. inline:
# the COMMIT that takes the journal past 1,000 pages does it, on the server's
# thread, as before 1.11.510 (0.1 to 0.26 s each on the k3s test machine).
# thread or inline; anything else stops the start.
# OSCAR_DB_CHECKPOINTS=thread

# When that thread copies the journal (#1294, server 1.11.536). It looks at
# the journal every second and copies it when its file is larger than
# OSCAR_DB_CHECKPOINT_MB (1 to 1024) or when its last checkpoint is older than
# OSCAR_DB_CHECKPOINT_SECONDS (1 to 600). Not at every look: the server's first
# write after a complete checkpoint starts the journal again and waits for the
# disk, and a checkpoint a second made that one wait a second (0.1 to 0.4 s
# each during a batch on the k3s test machine). Anything else stops the start.
# OSCAR_DB_CHECKPOINT_MB=16
# OSCAR_DB_CHECKPOINT_SECONDS=30

# From how many milliseconds a database statement is logged as slow (#1234).
# Each one writes a warning line "slow database statement" with its time, its
# SQL (never its values) and the place in OSCAR's code that ran it; OSCAR ·
# Logs lists them. A whole number from 1 to 60000, 50 by default; anything
# else stops the start.
# OSCAR_DB_SLOW_MS=50

# SQLite's memory on the server's connection (#1237). The page cache, in MB:
# 64 by default, 2 to 1024 (SQLite's own default is 2). How much of the
# database file is read through a memory map, in MB: 256 by default, 0 (none)
# to 2047; the mapped pages are the system's cache of the file, not a second
# copy. Where temporary sorts and groupings go: MEMORY (the default) or FILE.
# Anything else stops the start.
# OSCAR_DB_CACHE_MB=64
# OSCAR_DB_MMAP_MB=256
# OSCAR_DB_TEMP_STORE=MEMORY

# SQLite's statistics, which its planner reads to choose an index (#1238).
# off, the default since 1.11.524 (#1269): never (the statistics already kept
# stay; see Metrics and monitoring to remove them). daily: the checkpoint
# thread runs SQLite's PRAGMA optimize a minute after the start and then once
# a day, one table at a time. Each ANALYZE reads every index of its table in
# full and holds the write lock meanwhile: on a large database just after a
# restart, minutes, during which sign-ins and run results fail. Needs
# OSCAR_DB_CHECKPOINTS=thread. daily or off; anything else stops the start.
# OSCAR_DB_OPTIMIZE=off

# ── Runtime tuning ─────────────────────────────────────────────────────────

# Hard timeout per Bruno run (ms). 600000 = 10 min.
RUN_TIMEOUT_MS=600000

# Maximum number of Bruno runs that can execute concurrently.
MAX_CONCURRENT_RUNS=3

# Delay between staggered run launches in a parallel batch (ms).
PARALLEL_STAGGER_MS=2000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Wall-clock timezone used by every container in the stack (oscar, loki,
# promtail, grafana, prometheus, alertmanager, autoheal, watchtower).
# Affects log line timestamps, audit log entries, "Sent at" lines in
# emails, run start/finish times shown in the dashboard. Storage stays
# UTC ISO-8601 in the JSON layer — only the display side changes.
# Default Europe/Paris (canonical UIC OSCAR deployment).
# Override with any IANA zone, e.g. America/New_York, Asia/Tokyo.
OSCAR_TZ=Europe/Paris

# ── Datafile schema validation ────────────────────────────────────────────

# JSON_SCHEMA_URL: the JSON schema each run checks the data file against.
#
# Leave it unset. OSCAR_Server serves the schema bundled with the Bruno
# collection, and each run asks it where it reaches the server: the
# loopback when Bruno runs in this container, RUN_SERVER_URL when it runs
# in the oscar-runner container (RUN_ISOLATION=isolated). Set it only for
# a schema of your own, hosted elsewhere.
#
# Until 1.11.523 this file set it to http://127.0.0.1:3001/…: in isolated
# mode that is the runner container, where nothing answers, and every run
# logged "Error loading the schema: connect ECONNREFUSED 127.0.0.1:3001".
# Since 1.11.523 the server ignores a loopback value in that mode; remove
# the line from older .env files all the same (then `docker compose up -d
# oscar`). Never use the deprecated OSDM-testing/exch_dev GitHub URL.
# JSON_SCHEMA_URL=

# ── SMTP: the mail server (invitations, password resets, alerts) ───────────
# Read here at each start, once SMTP_HOST is set (server 1.11.565): Admin →
# Server Config shows these settings and does not change them. After a
# change, create the container again (docker compose up -d oscar; a
# "restart" keeps the old values), then send a test e-mail from Server Config.
# While SMTP_HOST is empty, an OSCAR whose mail server was saved from the
# page by an earlier version keeps using that one. For port 465 add
# SMTP_SECURE=true. SMTP_FROM must be a sender your mail server accepts.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Outbound target policy (tracker S5, v1.11.211) ─────────────────────────
# The company api_base (where runs send OSDM requests) and a tester's token_url
# (where OAuth tokens are fetched) must be public https addresses: OSCAR refuses
# loopback, private, link-local and Docker service names, at save and at use.
# Set this to 1 ONLY for a self-hosted / development box whose providers sit on
# localhost or a private network. A public deployment must leave it unset.
# While it is on, the server says so at each start and Admin → Server Config
# shows it.
ALLOW_PRIVATE_TARGETS=
