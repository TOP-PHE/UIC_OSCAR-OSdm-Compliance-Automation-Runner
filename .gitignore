# ── Runtime data (never commit) ─────────────────────────────────────────
OSCAR_Deploy/data/
OSCAR_Deploy/.env
Oscar_Server/data/

# ── Node ────────────────────────────────────────────────────────────────
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ── Build artifacts ─────────────────────────────────────────────────────
**/dist/
**/build/
**/coverage/
**/.nyc_output/

# ── Editor / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.vs/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Visual Studio / VS Code code-index caches — machine-local, never commit.
# These are the files OneDrive repeatedly fails to sync ("in use by another
# program") because the editor holds them open; keeping them out of git also
# stops them riding along in commits.
*.vsidx
*.db-shm
*.db-wal
CodeChunks.db
SemanticSymbols.db

# ── Logs ────────────────────────────────────────────────────────────────
*.log
logs/

# ── Env / secrets ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!**/.env.example

# ── Test outputs ────────────────────────────────────────────────────────
Oscar_Server/tests/tmp/
Bruno_Collection/results/
# Bruno run reports. The existing committed reports are kept as reference
# samples (they're already tracked — .gitignore does NOT untrack them). This
# only stops NEW locally-generated reports + the .report_tmp.json accumulator
# from being committed and cluttering the repo. To add a new reference report
# deliberately, use `git add -f <file>`.
Bruno_Collection/Validation_Reports/

# ── Bruno: local scratch ────────────────────────────────────────────────
# Personal working-notes folder the Bruno GUI creates locally. Not part of
# the shipped collection — keep it (and whatever drafts live in it) out of git.
Bruno_Collection/Dev working documents/

# ── OS / misc ───────────────────────────────────────────────────────────
*.bak
*.tmp
~$*

# Claude Code — personal, per-machine project settings (e.g. autoMemoryDirectory). Never commit.
.claude/settings.local.json
