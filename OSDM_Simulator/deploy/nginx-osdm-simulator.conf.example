# OSDM provider simulator — nginx reverse proxy.
#
# Copy to /etc/nginx/sites-available/osdm-simulator, replace the host name,
# enable with
#   sudo ln -s /etc/nginx/sites-available/osdm-simulator /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# then run certbot to add the TLS listener:
#   sudo certbot --nginx -d simulator.example.org
#
# OSCAR only accepts an OSDM endpoint that is https on a public host, so the
# certificate is not optional.

# At most 50 requests a second per caller address, with room for a burst.
# #1004: the OSCAR servers get a zone of their own. All of a server's runs come
# from its one address, about 4 requests a second per run, so 50 parallel runs
# send some 200. Put each OSCAR server's address below, and the same list in
# SIM_TRUSTED_ADDRESSES (./.env of the simulator).
geo $osdm_trusted {
    default        0;
    # 203.0.113.10 1;                           # <- an OSCAR server's address
}
# An empty key is not counted: each address is counted in one zone only.
map $osdm_trusted $osdm_public_key  { 0 $binary_remote_addr; 1 ""; }
map $osdm_trusted $osdm_trusted_key { 0 "";                  1 $binary_remote_addr; }
limit_req_zone $osdm_public_key  zone=osdm_simulator:10m rate=50r/s;
limit_req_zone $osdm_trusted_key zone=osdm_simulator_trusted:1m rate=300r/s;
# The administration (#930): the OSCAR server, a few requests at a time.
limit_req_zone $binary_remote_addr zone=osdm_simulator_admin:1m rate=5r/s;

server {
    listen 80;
    server_name simulator.example.org;          # <- the simulator's host name

    # The simulator refuses a body over 256 kB itself; this stops it earlier.
    client_max_body_size 512k;

    location / {
        limit_req zone=osdm_simulator burst=100 nodelay;
        limit_req zone=osdm_simulator_trusted burst=300 nodelay;
        limit_req_status 429;

        proxy_pass         http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        # Appends the caller's address; the simulator reads the last one.
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # The OSDM API uses no cookie; none is passed on.
        proxy_set_header   Cookie "";
        proxy_read_timeout 30s;
    }

    # The administration API (#930). Its one caller is the OSCAR server; to
    # keep it to that server, uncomment and put the OSCAR server's address:
    #   allow 203.0.113.10;
    #   deny  all;
    location /admin/ {
        limit_req zone=osdm_simulator_admin burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;

        proxy_pass         http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
