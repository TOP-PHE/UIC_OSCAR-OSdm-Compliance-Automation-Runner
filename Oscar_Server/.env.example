# OSCAR Server — Environment Configuration TEMPLATE
#
# Copy this file to `.env` in the same folder and fill in the placeholders.
# `.env` is gitignored and must NEVER be committed (it carries secrets).
#
# This template is for running the OSCAR server LOCALLY for development
# (Node 22+ on your laptop). For a production / VPS deployment, use the
# Docker-based stack — see OSCAR_Deploy/.env.example and the
# Documentation/Server_Operations/installation-guide.md.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Set to "production" only on a hardened deployment (enables HTTPS-redirect,
# stricter CSP, info-level default logging). Leave unset / "development" locally.
# NODE_ENV=production

# ── Security (required) ───────────────────────────────────────────────────────

# AES-256-GCM key used to encrypt user credentials at rest in the SQLite DB.
# MUST be exactly 64 hex characters (= 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT signing secret for web sessions. If left blank, the server generates a
# random one at every startup (which invalidates all sessions on restart —
# fine for dev, not for production).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# One-time bootstrap token used to create the first platform administrator
# via POST /v1/auth/bootstrap/platform-user. Once you have an admin, this
# token can be cleared.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_BOOTSTRAP_TOKEN=

# Comma-separated hostnames the HTTPS-redirect handler will trust as
# redirect targets (defense-in-depth against open-redirect via Host: forgery).
# Production example: ALLOWED_REDIRECT_HOSTS=oscar.example.org
ALLOWED_REDIRECT_HOSTS=

# ── Bruno Collection (required for runs) ──────────────────────────────────────
# Absolute path to your local OTST collection folder.
# Linux/macOS example:  COLLECTION_PATH=/home/you/Bruno_tests/OTST_V2.0.2
# Windows example:      COLLECTION_PATH=C:\path\to\Bruno_tests\OTST_V2.0.2
COLLECTION_PATH=

# Absolute path to the Bruno CLI binary (`bru` on Linux/macOS, `bru.cmd` on Windows).
# Install with: npm install -g @usebruno/cli
# Linux/macOS example:  BRU_CMD=/usr/local/bin/bru
# Windows example:      BRU_CMD=C:\Users\you\AppData\Roaming\npm\bru.cmd
BRU_CMD=

# JSON schema URL used to validate uploaded datafiles. Defaults to the canonical
# UIC schema; override only if you maintain a private fork.
JSON_SCHEMA_URL=https://raw.githubusercontent.com/UnionInternationalCheminsdeFer/OSDM-testing/refs/heads/exch_dev/json_validator/datafile.schema.json

# ── Run execution ─────────────────────────────────────────────────────────────
# All three are runtime-editable from the admin Server Config tab as well —
# .env values seed the DB on first boot, then the DB takes precedence.

# Hard timeout per Bruno run (ms). 600000 = 10 min.
RUN_TIMEOUT_MS=600000

# Ceiling for the per-run hard timeout when a scenario opts into a longer wait
# via expiredBookingMaxWaitMinutes (#204). The runner extends the worker SIGTERM
# to max(RUN_TIMEOUT_MS, scenario wait + buffer) — but never above this value.
# Prevents an abusive datafile from making the worker run effectively forever.
# 1800000 = 30 min. Raise if you need to test providers with very long
# confirmation deadlines.
RUN_HARD_MAX_TIMEOUT_MS=1800000

# #204 token-watchdog: while a Bruno run is in flight, the runner ticks every
# TOKEN_WATCHDOG_INTERVAL_MS to call resolveAccessToken on the cached
# per-tester token. The cache's own safety-margin check decides whether to
# refetch from the OAuth server or no-op — so this is a cheap background
# guard that ensures the cached token is always fresh enough for the next
# scenario's first request. Set to 0 to disable. Defaults to 5 min.
TOKEN_WATCHDOG_INTERVAL_MS=300000

# Maximum concurrent Bruno runs. 1 = sequential (safe default for laptops);
# bump to 3–5 for a server with sufficient CPU + memory.
MAX_CONCURRENT_RUNS=1

# Stagger between batched parallel run launches (ms). Prevents thundering-herd
# bursts against vendor APIs.
PARALLEL_STAGGER_MS=2000

# Pino log verbosity: trace | debug | info | warn | error | fatal
# Defaults to "info" in production, "debug" otherwise.
LOG_LEVEL=debug

# ── Application URL ───────────────────────────────────────────────────────────
# Used to build absolute links in outgoing emails (verification, password
# reset). Set to the public-facing URL users see in their browser.
# Local dev example:    APP_URL=http://localhost:3001
# Production example:   APP_URL=https://oscar.example.org
APP_URL=http://localhost:3001

# ── SMTP (optional — runtime-editable from Server Config tab) ─────────────────
# .env values seed the DB on first boot. After that, edit them in the admin
# UI without restarting. Leave blank to disable email sending entirely
# (registration verification + password reset will not work in that mode).
#
# Tested relays: Brevo (smtp-relay.brevo.com:587), SendGrid, Mailgun, Gmail.
# IMPORTANT: SMTP_USER is your relay's authentication identity (often a
# relay-internal id like a731f1001@smtp-brevo.com). SMTP_FROM is what
# recipients see — must be an address your relay has verified.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OSCAR Platform <noreply@example.org>

# ── Alerting (optional — runtime-editable, used only with metrics overlay) ───
# Comma-separated admin emails to receive Alertmanager alerts. Leave blank
# until the metrics + alerting stack is brought up; configure entirely from
# the Server Config tab in the admin UI then.
# ALERT_RECIPIENTS=admin@example.org
# ALERT_REPEAT_CRITICAL=1h
# ALERT_REPEAT_WARNING=4h
