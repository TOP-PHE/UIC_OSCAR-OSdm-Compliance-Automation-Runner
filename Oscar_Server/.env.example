# OSCAR Server — Environment Configuration
# Copy this file to oscar-server.env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Security ──────────────────────────────────────────────────────────────────
# JWT secret — use a long random string (min 32 chars)
JWT_SECRET=replace_with_long_random_secret_string

# One-time / server-side bootstrap token to create platform users
# via POST /v1/auth/bootstrap/platform-user
PLATFORM_BOOTSTRAP_TOKEN=replace_with_long_random_bootstrap_token

# AES-256-GCM encryption key for credentials stored in DB
# Must be exactly 64 hex characters (= 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string_generated_by_node

# ── Bruno Collection ──────────────────────────────────────────────────────────
# Absolute Windows path to the OTST_V2.0.1 collection folder
COLLECTION_PATH=C:\Users\patri\OneDrive\Documents\TrackOnPath\Contract_execution\UIC_New_Revenue_Management project\projets\OSDM\OTST\Bruno_tests\OTST_Bruno_Workspace\OTST_V2.0.1

# Absolute Windows path to bru.cmd
BRU_CMD=C:\Users\patri\AppData\Roaming\npm\bru.cmd

# JSON schema URL injected into every generated environment
JSON_SCHEMA_URL=https://raw.githubusercontent.com/UnionInternationalCheminsdeFer/OSDM-testing/refs/heads/exch_dev/json_validator/datafile.schema.json

# ── Run execution ─────────────────────────────────────────────────────────────
# Hard timeout per run in milliseconds (default 10 minutes)
RUN_TIMEOUT_MS=600000

# Maximum concurrent runs (MVP: 1 — sequential execution)
MAX_CONCURRENT_RUNS=1

# ── Email (for registration verification) ────────────────────────────────────
# If not set, verification URLs are printed to the console (dev mode only)
APP_URL=https://vps119497.serveur-vps.net
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=OSCAR Platform <noreply@trackonpath.com>
