{
  "name": "oscar-server",
  "version": "1.11.166",
  "description": "OSCAR — OSDM Conformance Automation Runner Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src/ && node scripts/lint-inline-scripts.js",
    "lint:fix": "eslint src/ --fix",
    "lint:html": "node scripts/lint-inline-scripts.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "verbose": true,
    "testTimeout": 10000
  },
  "dependencies": {
    "bcrypt": "~6.0.0",
    "cors": "~2.8.5",
    "dotenv": "~16.6.1",
    "express": "~4.22.2",
    "express-rate-limit": "~8.5.2",
    "express-validator": "~7.3.2",
    "helmet": "~8.2.0",
    "jsonwebtoken": "~9.0.2",
    "multer": "~2.2.0",
    "nodemailer": "~9.0.1",
    "pino": "~10.3.1",
    "pino-pretty": "~13.1.3",
    "prom-client": "~15.1.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "~9.39.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "_notes": "SQLite via built-in node:sqlite (Node.js 22+) — no native compilation needed",
  "overrides": {
    "js-yaml": "4.2.0",
    "@babel/core": "^7.29.6"
  }
}
